# Murmur settings: ~/.config/murmur/.env (make deps creates it). Re-read at every recording.
# Transcription is always Apple's on-device speech recognition. Summaries always go through
# your Claude Code or Codex login: no API keys, no local models.

# Summary engine: claude-code (default) or codex. If the chosen one isn't installed, the other is used.
SUMMARY_ENGINE=claude-code

# Spoken language: auto (follows the system language) or a locale such as en-US, pt-BR, es-ES.
LANGUAGE=auto

# Global start/stop shortcut, e.g. ctrl+option+cmd+r (default), cmd+shift+9, or off.
# Needs at least one of ctrl/option/cmd. Restart Murmur after changing it.
HOTKEY=ctrl+option+cmd+r

# Global mute/unmute shortcut while recording, e.g. ctrl+option+cmd+m (default), or off.
# Same rules as HOTKEY. Restart Murmur after changing it.
MUTE_HOTKEY=ctrl+option+cmd+m

# Live transcript window while recording: on (default) or off. It can always be opened from the menu.
LIVE_TRANSCRIPT=on

# NOTES_DIR=~/MeetingNotes
# CLAUDE_CODE_MODEL=opus
# CLAUDE_CODE_BIN=~/.local/bin/claude
# CODEX_MODEL=gpt-5.5
# Questions in the live window. Default: sonnet for Claude Code; for Codex, CODEX_MODEL.
# CLAUDE_CODE_CHAT_MODEL=sonnet
# CODEX_CHAT_MODEL=gpt-5.5
# CODEX_BIN=~/.local/bin/codex
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
